# MWP API
MWP_API_URL=https://mindwork.place/aiqmsapi/getmwpactiveuser
MWP_CLIENT_KEY=
MWP_API_TOKEN=

# Tenant database — WorkspaceNode/RoleAssignment/NodeAssignment (and this job's own tables) live
# here. NOT where `users` rows go (see CONTROL_PLANE_DATABASE_URL below). Point this at the
# workspace's dedicated database only. Never the shared/shard database.
DATABASE_URL=postgresql://neondb_owner:<password>@<dedicated-host>/neondb?sslmode=require&channel_binding=require

# Safety guard (src/preflight.ts): must exactly match the hostname in DATABASE_URL above, or the
# run aborts before touching anything. Copy this from the same dedicated connection string.
MWP_SYNC_EXPECTED_DB_HOST=<dedicated-host>

# identity-service's control-plane database — `users` is control-plane data ALWAYS, regardless of
# workspace dbStrategy (AuthRepository/UserManagementRepository are fixed singletons bound to this
# DB, never per-tenant). This is SHARED by every workspace/tenant on the platform — extra care.
CONTROL_PLANE_DATABASE_URL=postgresql://<user>:<password>@<control-plane-host>:5432/<db>

# Safety guard: must exactly match the hostname in CONTROL_PLANE_DATABASE_URL above.
MWP_SYNC_CONTROL_PLANE_EXPECTED_HOST=<control-plane-host>

# The workspace all synced users belong to (control-plane workspaceId for this workspace).
MWP_SYNC_WORKSPACE_ID=

# One PermissionGroup id per category — must already exist as rows in this workspace's
# permission_groups table (RoleAssignment.permissionGroupId is NOT NULL).
MWP_SYNC_PERMISSION_GROUP_IDS={"agent":"<uuid>","qa":"<uuid>","supervisor":"<uuid>","team_leader":"<uuid>"}

# Only used by index.ts (daemon mode) — not needed for a one-shot manual run.
MWP_SYNC_CRON_SCHEDULE=0 2 * * *
MWP_SYNC_LOCK_TTL_MS=1800000
